# Copy to `.env` (gitignored) and fill in real values.
# No secret is ever committed. Tokens for brokers live in data/tokens.json.

# ---- Base currency for the consolidated view ----
BASE_CURRENCY=INR

# ---- FX source (deterministic, free, no key) ----
FX_SOURCE=open.er-api.com

# ---- Telegram (M1 expiry warnings, M2/M6 alerts) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- SQLite path (default: data/portfolio.db) ----
PORTFOLIO_DB_PATH=data/portfolio.db