# ---- Claude Code local state ----
.claude/worktrees/
.claude/.headroom_wrap_*

# ---- shadcn MCP local install artifacts (repo-root, not the dashboard app) ----
/node_modules/
/package.json
/package-lock.json

# ---- Python / uv ----
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---- Environment & secrets (guardrail #2: never commit) ----
.env
data/tokens.json
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/*.db.bak
data/logs/

# Live personal portfolio data - the M8 export carries real holdings/values.
dashboard/public/data/

# CAS statements + parsed output (PDFs and raw JSON carry PII: name, email,
# PAN, folios). Only SCRUBBED fixtures (samples/cas/*_scrubbed.json) commit.
data/cas/
samples/cas/*_raw.json

# Real-estate property valuations (manual entries carry PII: address, prices).
data/properties/

# Raw samples that accidentally captured credentials. Safe/pinned samples
# (holdings/quotes only, tokens redacted) ARE committed for regression.
samples/*_token*
samples/*credential*

# Live personal portfolio data — NEVER commit. Anything captured against an
# authenticated session (*_authed.json: real holdings/positions/quotes) is
# private. Only unauthenticated error baselines + tool inventories are committed.
samples/**/*_authed.json

# ---- Local scheduler / OS ----
scripts/*.bat.tmp
Thumbs.db
.DS_Store

# Botched `shadcn add` artifact — an `@/components/ui/` copy that duplicates
# dashboard/src/components/ui/. Real components live under dashboard/src/.
dashboard/@/

# Playwright e2e artifacts — screenshots + test-results/ are throwaway debug
# output (dashboard/e2e/*.png, test-results/); specs (.spec.ts) DO commit.
dashboard/e2e/*.png
test-results/

# pnpm artifacts — project uses npm; these are stray leftovers
dashboard/pnpm-lock.yaml
dashboard/pnpm-workspace.yaml

# TypeScript build output
dashboard/tsc_out.txt

# Local run output / error capture
err.txt
out.txt
# Stray artifact
=

# Local dev helper (not needed in repo)
run-all.ps1

# Throwaway dashboard scripts
dashboard/scripts/check-daypnl.ts
dashboard/scripts/test-milestones.ts

# Design exploration docs (not final specs)
docs/design/2026-08-20-chat-drawer-positioning.md
docs/design/directions/2026-08-20-journey-shadcn-charts-direction-1.md
docs/design/spec-allocation-donuts/

