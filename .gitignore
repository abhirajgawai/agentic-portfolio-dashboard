# ---- Python / uv ----
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ---- Environment & secrets (guardrail #2: never commit) ----
.env
data/tokens.json
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Raw samples that accidentally captured credentials. Safe/pinned samples
# (holdings/quotes only, tokens redacted) ARE committed for regression.
samples/*_token*
samples/*credential*

# Live personal portfolio data — NEVER commit. Anything captured against an
# authenticated session (*_authed.json: real holdings/positions/quotes) is
# private. Only unauthenticated error baselines + tool inventories are committed.
samples/**/*_authed.json

# ---- Local scheduler / OS ----
scripts/*.bat.tmp
Thumbs.db
.DS_Store

# ---- opencode node_modules (its own .gitignore also covers this) ----
.opencode/node_modules/